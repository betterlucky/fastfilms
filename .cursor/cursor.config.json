{
  "version": "1.0",
  "settings": {
    "autoFormat": true,
    "formatOnSave": true,
    "lintOnSave": true,
    "suggestions": {
      "enabled": true,
      "showDocumentation": true,
      "showTypeInfo": true
    },
    "rules": {
      "enforceNamingConventions": true,
      "enforceFileStructure": true,
      "enforceDocumentation": true,
      "enforceTesting": true
    },
    "customCommands": {
      "formatCode": "prettier --write",
      "lintCode": "eslint --fix",
      "runTests": "jest"
    }
  }
} 