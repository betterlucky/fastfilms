{
  "version": 2,
  "framework": "nextjs",
  "regions": ["lhr1"],
  "buildCommand": "npm run vercel-build",
  "env": {
    "NEXTAUTH_URL": "https://fastfilms-staging.vercel.app"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-guest-lists",
      "schedule": "0 6 * * *"
    }
  ]
}
