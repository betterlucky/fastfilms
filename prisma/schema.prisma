generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  VENUE_ADMIN
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum TicketStatus {
  PENDING
  CONFIRMED
  PAY_IT_FORWARD
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole        @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  comments      Comment[]
  Contribution  Contribution[]
  sessions      Session[]
  tickets       Ticket[]
  ticketResends TicketResend[]
  purchases     Purchase[]       // Add relation to purchases
  purchaseResends PurchaseResend[] // Add relation to purchase resends
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Charity {
  id          String     @id @default(cuid())
  name        String
  description String?
  logoPath    String?
  url         String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model Campaign {
  id             String             @id @default(cuid())
  title          String
  description    String
  movieTitle     String
  venueId        String
  screeningDate  DateTime
  ticketCap      Int
  currentTickets Int                @default(0)
  fundingTarget  Float
  currentFunding Float              @default(0)
  deadlineDate   DateTime
  isFeatured     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  posterPath     String?
  screenId       String?
  charityId      String?
  customBlurb    String?
  tmdbId         String?
  status         String             @default("ACTIVE")
  isTest         Boolean            @default(false)
  charity        Charity?           @relation(fields: [charityId], references: [id])
  screen         Screen?            @relation(fields: [screenId], references: [id])
  venue          Venue              @relation(fields: [venueId], references: [id])
  menuItems      CampaignMenuItem[]
  comments       Comment[]
  Contribution   Contribution[]
  tickets        Ticket[]
  purchases      Purchase[]         // Add relation to purchases
}

model Venue {
  id           String     @id @default(cuid())
  name         String
  address      String
  city         String
  postcode     String
  phone        String?
  url          String?
  contactEmail String[]
  campaigns    Campaign[]
  menuItems    MenuItem[]
  screens      Screen[]
}

model Screen {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  venueId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
  venue     Venue      @relation(fields: [venueId], references: [id])
}

model MenuItem {
  id          String             @id @default(cuid())
  name        String
  description String
  price       Decimal
  venueId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  category    String
  isActive    Boolean            @default(true)
  campaigns   CampaignMenuItem[]
  venue       Venue              @relation(fields: [venueId], references: [id])
  options     MenuItemOption[]
  orders      Order[]

  @@index([category])
}

model MenuItemOption {
  id           String                 @id @default(cuid())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  name         String
  menuItemId   String
  description  String?
  maxChoices   Int                    @default(1)
  minChoices   Int                    @default(1)
  order        Int                    @default(0)
  menuItem     MenuItem               @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  choices      MenuItemOptionChoice[]
  orderChoices OrderChoice[]

  @@index([menuItemId])
  @@index([order])
}

model MenuItemOptionChoice {
  id              String         @id @default(cuid())
  name            String
  priceAdjustment Decimal        @default(0)
  optionId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  option          MenuItemOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  orderChoices    OrderChoice[]

  @@index([optionId])
}

model Ticket {
  id          String         @id @default(cuid())
  purchaseId  String
  campaignId  String
  userId      String
  pricePaid   Decimal       @db.Decimal(10, 2)
  status      TicketStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  campaign    Campaign      @relation(fields: [campaignId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
  resends     TicketResend[]

  @@index([purchaseId])
  @@index([campaignId])
  @@index([userId])
}

model TicketResend {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model Order {
  id          String        @id @default(cuid())
  purchaseId  String
  menuItemId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quantity    Int
  menuItem    MenuItem      @relation(fields: [menuItemId], references: [id])
  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
  choices     OrderChoice[]

  @@index([purchaseId])
}

model Purchase {
  id                    String         @id @default(cuid())
  campaignId            String
  userId                String
  status                PurchaseStatus @default(PENDING)
  stripePaymentIntentId String?
  totalAmount           Decimal        @db.Decimal(10, 2)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  orders                Order[]
  tickets               Ticket[]
  campaign              Campaign       @relation(fields: [campaignId], references: [id])
  user                  User           @relation(fields: [userId], references: [id])
  resends               PurchaseResend[]

  @@index([campaignId])
  @@index([userId])
}

model PurchaseResend {
  id          String   @id @default(cuid())
  purchaseId  String
  userId      String
  createdAt   DateTime @default(now())
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([purchaseId])
  @@index([userId])
}

model OrderChoice {
  id               String               @id @default(cuid())
  orderId          String
  optionId         String
  selectedChoiceId String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  option           MenuItemOption       @relation(fields: [optionId], references: [id])
  order            Order                @relation(fields: [orderId], references: [id])
  selectedChoice   MenuItemOptionChoice @relation(fields: [selectedChoiceId], references: [id])
}

model Comment {
  id         String    @id @default(cuid())
  content    String
  campaignId String
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  parentId   String?
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  user       User      @relation(fields: [userId], references: [id])
}

model CampaignMenuItem {
  id         String   @id @default(cuid())
  campaignId String
  menuItemId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([campaignId, menuItemId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Contribution {
  id         String   @id
  amount     Decimal
  campaignId String
  userId     String
  createdAt  DateTime @default(now())
  Campaign   Campaign @relation(fields: [campaignId], references: [id])
  User       User     @relation(fields: [userId], references: [id])
}
